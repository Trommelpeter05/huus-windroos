# This file was created with significant AI assistance (e.g., Claude)
# to handle the Apache settings of the static PHP version (404 page, protection of config/lib, caching).
#
# It has been reviewed, tested, and approved by a human developer
# to ensure quality and correctness.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Only if config/ and lib/ have to live inside the web root: never deliver them
  RewriteRule ^(config|lib)(/|$) - [F,L]

  # Fix: 301 redirects of the old WordPress addresses (keep links and Google ranking).
  # NE = keep the "#" of the anchor targets unencoded.
  RewriteRule ^startseite\.html$ / [R=301,L]
  RewriteRule ^ferienwohnung\.html$ /#ferienwohnung [R=301,NE,L]
  RewriteRule ^ferienapartment\.html$ /#apartment [R=301,NE,L]
  RewriteRule ^(urlaub-in-ostfriesland|fischerdorf-ditzum)\.html$ /#ostfriesland [R=301,NE,L]
  RewriteRule ^impressum\.html$ /impressum/ [R=301,L]
  RewriteRule ^datenschutzerklaerung\.html$ /datenschutz/ [R=301,L]
  RewriteRule ^agb\.html$ /agb/ [R=301,L]
  # old WordPress paths (admin, feeds, uploads) → start page
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|feed|comments)(/|$) / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_nuxt/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
